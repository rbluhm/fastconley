+`Void' reghdfe_external_vce_update_F(`Solution' sol)
+{
+	`Matrix' inv_V
+	`RowVector' idx
+	sol.F = .
+	if (!sol.K) return
+	idx = 1..sol.K
+	inv_V = invsym(sol.V[idx, idx])
+	if (!diag0cnt(inv_V)) sol.F = sol.b[idx]' * inv_V * sol.b[idx] / sol.df_m
+}
+
+
+`Boolean' reghdfe_external_vce_is_valid(`Solution' sol)
+{
+	`Real' scale
+	`Integer' expected_K
+	expected_K = rows(sol.b)
+	if (rows(sol.V) != expected_K | cols(sol.V) != expected_K) return(0)
+	if (hasmissing(sol.V)) return(0)
+	if (!expected_K) return(1)
+	scale = max(abs(sol.V))
+	return(max(abs(sol.V - sol.V')) <= 1e-12 * scale)
+}
+
